{
  // Trigger another Workers build. This comment does not change the Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axeel-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "axeel-dev" }],
  // Every domain the Worker answers on must be listed here: each deploy removes any that aren't.
  "routes": [
    { "pattern": "axelp.dev", "custom_domain": true },
    { "pattern": "axeel.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "keep_vars": true
}
