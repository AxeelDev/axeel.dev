# Copy to .env.local. Demo mode needs no accounts or credentials.
CONTENT_SOURCE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# To use your real database, change CONTENT_SOURCE to supabase and fill these in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add a service-role or secret key. The app uses your session + RLS.
